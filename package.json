{
  "name": "devbox-workspace",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "check": "turbo run check",
    "fix": "turbo run fix",
    "test": "turbo run test"
  },
  "devDependencies": {
    "turbo": "^2.11.13"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.4",
      "onFail": "warn"
    }
  }
}
